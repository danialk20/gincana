# Copia este archivo como .env.local y pega los valores de tu proyecto de Firebase.
# Los encuentras en: consola de Firebase → ⚙ Configuración del proyecto → Tus apps → App web.
#
# Mientras este archivo no exista, la app funciona en "modo local": guarda todo en
# el propio dispositivo. Sirve para ensayar, pero no comparte datos con el televisor.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
